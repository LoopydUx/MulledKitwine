{
  "name": "cantina-cana-mulled-wine-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One-page scroll-driven product story for the Cantina Cana Mulled Wine Kit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "verify:story": "node scripts/verify-choreography.ts",
    "stills": "node scripts/capture-stills.mjs",
    "verify:page": "node scripts/verify-page.mjs",
    "look": "node scripts/look.mjs",
    "verify": "npm run typecheck && npm run verify:story && npm run verify:page"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
